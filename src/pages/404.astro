---
import BaseLayout from '../layouts/BaseLayout.astro';
import { url } from '../lib/utils';
---

<BaseLayout title="404">
  <div class="container narrow nf">
    <p class="eyebrow">$ cat {Astro.url.pathname}</p>
    <h1 class="mono">404: No such file or directory</h1>
    <p class="muted">This page doesn't exist, or it has moved somewhere else.</p>
    <a class="btn btn-primary" href={url('/')}>cd ~</a>
  </div>
</BaseLayout>

<style>
  .nf {
    padding-top: 96px;
  }
  h1 {
    margin: 0 0 12px;
    font-size: clamp(1.4rem, 4vw, 2rem);
  }
  p.muted {
    margin: 0 0 24px;
  }
</style>
