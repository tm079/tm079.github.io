---
import { SITE } from '../site.config';
import { url } from '../lib/utils';

const path = Astro.url.pathname;
const nav = [
  { href: '/writeups/', label: 'Write-ups' },
  { href: '/tags/', label: 'Tags' },
  { href: '/about/', label: 'About' },
];
const isActive = (href: string) => path.startsWith(url(href).replace(/\/$/, ''));
---

<header class="site-header">
  <div class="container header-inner">
    <a href={url('/')} class="brand mono" aria-label="Home">
      <span class="brand-prompt">~/</span>{SITE.username}<span class="cursor" aria-hidden="true">_</span>
    </a>

    <nav class="site-nav" aria-label="Main">
      {
        nav.map((item) => (
          <a href={url(item.href)} class:list={['nav-link', { active: isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a href={url('/search/')} class="icon-btn" aria-label="Search" title="Search">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path></svg>
      </a>
      <button type="button" class="icon-btn" id="theme-toggle" aria-label="Toggle light/dark theme" title="Toggle theme">
        <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
        <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path></svg>
      </button>
      <a href={`https://github.com/${SITE.username}`} class="icon-btn" aria-label="GitHub" title="GitHub" rel="me noopener" target="_blank">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.87-1.37-3.87-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.72.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.69 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path></svg>
      </a>
    </div>
  </div>
</header>

<script>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const next = document.documentElement.dataset.theme === 'light' ? 'dark' : 'light';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch {}
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: saturate(140%) blur(10px);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    gap: 8px 24px;
    min-height: 60px;
    flex-wrap: wrap;
  }
  .brand {
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    min-width: 0;
  }
  .brand:hover {
    text-decoration: none;
  }
  .brand-prompt {
    color: var(--accent);
  }
  .site-nav {
    display: flex;
    gap: 4px;
  }
  .nav-link {
    padding: 6px 10px;
    border-radius: 6px;
    color: var(--text-muted);
    font-size: 0.93rem;
    font-weight: 500;
  }
  .nav-link:hover {
    color: var(--text);
    background: var(--bg-soft);
    text-decoration: none;
  }
  .nav-link.active {
    color: var(--text);
    background: var(--bg-soft);
  }
  .header-actions {
    display: flex;
    gap: 4px;
    margin-left: auto;
  }
  .icon-btn {
    display: inline-grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 8px;
    color: var(--text-muted);
    background: transparent;
    border: 0;
    cursor: pointer;
  }
  .icon-btn:hover {
    color: var(--text);
    background: var(--bg-soft);
  }
  :global(:root[data-theme='light']) .icon-sun,
  :global(:root:not([data-theme='light'])) .icon-moon {
    display: none;
  }

  @media (max-width: 640px) {
    .header-inner {
      padding-top: 8px;
      padding-bottom: 6px;
    }
    .brand {
      flex: 1;
    }
    .site-nav {
      order: 3;
      width: 100%;
      margin: 0 -10px;
    }
  }
</style>
