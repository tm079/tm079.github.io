---
import { SITE } from '../site.config';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container footer-inner">
    <p class="mono">© {year} {SITE.author}</p>
    <ul class="footer-links">
      {SITE.socials.map((s) => <li><a href={s.href} rel="me noopener">{s.label}</a></li>)}
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: 64px;
    border-top: 1px solid var(--border);
    color: var(--text-faint);
    font-size: 0.85rem;
  }
  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 8px 24px;
    padding-top: 22px;
    padding-bottom: 28px;
  }
  p {
    margin: 0;
  }
  .footer-links {
    display: flex;
    gap: 18px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .footer-links a {
    color: var(--text-muted);
  }
</style>
